package BankAccount;

import java.io.BufferedReader;
import java.io.BufferedWriter;
import java.io.File;
import java.io.FileReader;
import java.io.FileWriter;
import java.io.IOException;
import java.util.ArrayList;
import java.util.List;

public class Bank {
	
	 private List<BankAccount> accounts = new ArrayList<>();
	 private static final String DATA_FILE = "accounts.txt";
	 
	// ---------- File I/O: load accounts back from the text file ----------
	 public void loadFromFile() throws IOException {
		 File file = new File(DATA_FILE);
		 if(!file.exists()) {
			 return;
		 }
		 accounts.clear();
		 BufferedReader reader = null;
		 try {
			 reader = new BufferedReader(new FileReader(file));
			 String line;
			 while((line= reader.readLine()) != null) {
				 if(line.trim().isEmpty()) {
					 continue;
				 }
				 String[] parts = line.split(",");
				 String type = parts[0];
				 String number = parts[1];
				 String holder = parts[2];
				 double balance = Double.parseDouble(parts[3]);
				 double extra = Double.parseDouble(parts[4]);
				 
				 if(type.equals("Savings")) {
					 accounts.add(new SavingsAccount(number, holder, balance, extra));
				 } else {
					 accounts.add(new CheckingAccount(number, holder, balance, extra));
				 }
			 }
		 } finally {
			 if(reader != null) reader.close();
		 }
		 
	 }
	 
	 public void saveToFile() throws IOException {
		 BufferedWriter writer = null;
		 try {
			 writer = new BufferedWriter(new FileWriter(DATA_FILE));
			 for(BankAccount acc: accounts) {
				 StringBuilder line = new StringBuilder();
	                line.append(acc.getAccountType()).append(",")
	                        .append(acc.getAccountNumber()).append(",")
	                        .append(acc.getAccountHolder()).append(",")
	                        .append(acc.getBalance()).append(",");

	                if (acc instanceof SavingsAccount) {
	                    SavingsAccount sa = (SavingsAccount) acc;
	                    line.append(sa.getInterestRate());
	                } else if (acc instanceof CheckingAccount) {
	                    CheckingAccount ca = (CheckingAccount) acc;
	                    line.append(ca.getOverdraftLimit());
	                } else {
	                    line.append("0.0");
	                }

	                writer.write(line.toString());
	                writer.newLine();
			 }
		 } finally {
			if (writer != null) {
	            writer.close();
	        }
		 }
	 }
	 
	// ----- Overloading (#1): find by account number -----
	    public BankAccount findAccount(String accountNumber) {
	        for (BankAccount acc : accounts) {
	            if (acc.getAccountNumber().equalsIgnoreCase(accountNumber)) {
	                return acc;
	            }
	        }
	        return null;
	    }

	    // ----- Overloading (#2): find by account holder name -----
	    public BankAccount findAccount(String holderName, boolean searchByHolder) {
	        if (!searchByHolder) {
	            return findAccount(holderName);
	        }
	        for (BankAccount acc : accounts) {
	            if (acc.getAccountHolder().equalsIgnoreCase(holderName)) {
	                return acc;
	            }
	        }
	        return null;
	    }

	 
	    public void addAccount(BankAccount account) {
	        accounts.add(account);
	    }
	    
	    public List<BankAccount> getAccounts() {
	    	return accounts;
	    }
	    
}
