package BankAccount;

import java.io.BufferedReader;
import java.io.File;
import java.io.FileReader;
import java.io.IOException;
import java.util.ArrayList;
import java.util.List;

public class Bank {
	
	 private List<BankAccount> accounts = new ArrayList<>();
	 private static final String DATA_FILE = "accounts.txt";
	 
	 
	 public void loadFromFile() throws IOException {
		 File file = new File(DATA_FILE);
		 if(!file.exists()) {
			 return;
		 }
		 accounts.clear();
		 BufferedReader reader = null;
		 try {
			 reader = new BufferedReader(new FileReader(file));
			 String line;
			 while((line= reader.readLine()) != null) {
				 if(line.trim().isEmpty()) {
					 continue;
				 }
				 String[] parts = line.split(",");
				 String type = parts[0];
				 String number = parts[1];
				 String holder = parts[2];
				 double balance = Double.parseDouble(parts[3]);
				 double extra = Double.parseDouble(parts[4]);
				 
				 if(type.equals("Savings")) {
					 accounts.add(new SavingAccount(number, holder, balance, extra));
				 } else {
					 accounts.add(new CheckingAccount(number, holder, balance, extra));
				 }
			 }
		 } finally {
			 if(reader != null) reader.close();
		 }
		 
	 }
}
