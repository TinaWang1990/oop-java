	private void onCreateAccount() {
		try {
			String number = accNumberField.getText().trim();
            String holder = holderField.getText().trim();
            String type = (String) typeCombo.getSelectedItem();

            if (number.isEmpty() || holder.isEmpty()) {
                throw new IllegalArgumentException("Account number and holder name are required.");
            }
            if (bank.findAccount(number) != null) {
                throw new IllegalArgumentException("Account number already exists.");
            }

            double balance = amountField.getText().trim().isEmpty() ? 0.0
                    : Double.parseDouble(amountField.getText().trim());
            double extra = rateOrLimitField.getText().trim().isEmpty() ? 0.0
                    : Double.parseDouble(rateOrLimitField.getText().trim());
			
			BankAccount acc;
            if (type.equals("Savings")) {
            	if (extra > 0) {
                    acc = new SavingsAccount(number, holder, balance, extra);
                } else {
                    acc = new SavingsAccount(number, holder);
                }
            } else {
            	if (extra > 0) {
                    acc = new CheckingAccount(number, holder, balance, extra);
                } else {
                    acc = new CheckingAccount(number, holder, balance);
                }
            }
			bank.addAccount(acc);
			refreshTable();
			log("Created: " + acc); // uses overridden toString()
			clearInputs();
		} catch (NumberFormatException ex) {
            showError("Balance and rate/limit must be valid numbers.");
        } catch (IllegalArgumentException ex) {
            showError(ex.getMessage());
        }
	}
	
