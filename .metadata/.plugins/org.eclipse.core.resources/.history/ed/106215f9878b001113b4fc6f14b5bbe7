public class BankGUI extends JFrame {
	
	private JTextField accNumberField;
	private JTextField holderField;
    private JTextField amountField;
    private JTextField rateOrLimitField;
    private JComboBox<String> typeCombo;
    private JTextArea logArea;  
    private DefaultTableModel tableModel;
    private JTable table;
	
	public BankGUI( ) {
		super("Bank Account Management System");
		setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
		setSize(850, 620);
		setLocationRelativeTo(null);
		initComponents();
		loadAccountsFromFile();
	}
	
	public void initComponents() {
		setLayout(new BorderLayout(10, 10));
		
		// ---- Top: form panel for creating accounts / entering amounts ----
        JPanel formPanel = new JPanel(new GridLayout(2, 6, 5, 5));
        formPanel.setBorder(BorderFactory.createTitledBorder("Account Operations"));

        accNumberField = new JTextField();
        holderField = new JTextField();
        amountField = new JTextField();
        rateOrLimitField = new JTextField();
        typeCombo = new JComboBox<String>(new String[]{"Savings", "Checking"});

        formPanel.add(new JLabel("Acc Number:"));
        formPanel.add(new JLabel("Holder:"));
        formPanel.add(new JLabel("Type:"));
        formPanel.add(new JLabel("Balance / Amount:"));
        formPanel.add(new JLabel("Rate (Savings) / Limit (Checking):"));
        formPanel.add(new JLabel(""));

        formPanel.add(accNumberField);
        formPanel.add(holderField);
        formPanel.add(typeCombo);
        formPanel.add(amountField);
        formPanel.add(rateOrLimitField);

        JButton createBtn = new JButton("Create Account");
        formPanel.add(createBtn);

        add(formPanel, BorderLayout.NORTH);
        
        // ---- Center: table listing all accounts ----
        tableModel = new DefaultTableModel(new Object[] {"Type", "Account #", "Holder", "Balance", "Interest"}, 0);
        table = new JTable(tableModel);
        add(new JScrollPane(table), BorderLayout.CENTER);
        
        // ---- Bottom: action buttons + activity log ----
        JPanel bottomPanel = new JPanel(new BorderLayout());
        JPanel btnPanel = new JPanel();
        JButton depositBtn = new JButton("Deposit");
        JButton withdrawBtn = new JButton("Withdraw");
        JButton interestBtn = new JButton("Calc Interest (selected)");
        JButton saveBtn = new JButton("Save to File");
        JButton loadBtn = new JButton("Load from File");
        btnPanel.add(depositBtn);
        btnPanel.add(withdrawBtn);
        btnPanel.add(interestBtn);
        btnPanel.add(saveBtn);
        btnPanel.add(loadBtn);
        
        logArea = new JTextArea(6, 60);
        logArea.setEditable(false);

        bottomPanel.add(btnPanel, BorderLayout.NORTH);
        bottomPanel.add(new JScrollPane(logArea), BorderLayout.CENTER);
        add(bottomPanel, BorderLayout.SOUTH);
        
        // ---- Wire up listeners ----
        createBtn.addActionListener(new java.awt.event.ActionListener() {
            public void actionPerformed(ActionEvent e) { onCreateAccount(); }
        });
        depositBtn.addActionListener(new java.awt.event.ActionListener() {
            public void actionPerformed(ActionEvent e) { onDeposit(); }
        });
        withdrawBtn.addActionListener(new java.awt.event.ActionListener() {
            public void actionPerformed(ActionEvent e) { onWithdraw(); }
        });
        interestBtn.addActionListener(new java.awt.event.ActionListener() {
            public void actionPerformed(ActionEvent e) { onCalcInterest(); }
        });
        saveBtn.addActionListener(new java.awt.event.ActionListener() {
            public void actionPerformed(ActionEvent e) { onSave(); }
        });
        loadBtn.addActionListener(new java.awt.event.ActionListener() {
            public void actionPerformed(ActionEvent e) { loadAccountsFromFile(); }
        });
	}
	
